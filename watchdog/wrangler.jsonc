{
  // Watchdog Worker for lakelevelfinder.com (plan §8.7). Deployed by the manual GitHub workflow
  // .github/workflows/watchdog-deploy.yml, which fills the placeholders on the runner:
  // the KV namespace id ("lakelevelfinder-watchdog-kv"), the alert address (repo secret WATCHDOG_ALERT_TO,
  // a verified Email Routing destination) and the repo name (from GITHUB_REPOSITORY). Nothing private is committed.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lakelevelfinder-watchdog",
  "main": "src/index.js",
  "compatibility_date": "2026-11-23",
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    "SITE_DOMAIN": "lakelevelfinder.com",
    // Before launch (domain not live) the watchdog reads status.json from the public repo instead of the site.
    // Set to "" after the first deploy so it checks what visitors see (docs/runbook.md step 8).
    "STATUS_URL": "https://raw.githubusercontent.com/issbguru-png/lakelevelfinder/main/data/status.json",
    "ALERT_TO": "REPLACE_WITH_VERIFIED_ADDRESS",
    "GH_REPO": "REPLACE_WITH_OWNER/REPLACE_WITH_REPO",
    "GH_WORKFLOW": "update.yml",
    "GH_ACCURACY_WORKFLOW": "accuracy.yml",
    "GH_REF": "main"
  },
  // Secret GH_TOKEN (set by watchdog-deploy.yml from repo secret GH_DISPATCH_TOKEN) enables the hourly dispatch.
  "kv_namespaces": [{ "binding": "WATCHDOG", "id": "REPLACE_WITH_KV_ID" }],
  "send_email": [{ "name": "ALERT", "destination_address": "REPLACE_WITH_VERIFIED_ADDRESS" }],
  "workers_dev": false,
  "preview_urls": false
}
